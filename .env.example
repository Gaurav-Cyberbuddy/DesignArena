# Supabase project URL (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=

# Browser-safe key. Use the anon key or the newer publishable key
# (sb_publishable_...). Never put a service-role or secret key here.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Use the service_role key or the newer secret key
# (sb_secret_...). Never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated organizer emails. Checked on the server only.
# Example: organizer@college.edu,admin@designarena.local
ADMIN_EMAILS=

# Optional Resend integration. Leave blank to keep the app fully
# functional with in-app confirmations only (no fake "email sent").
RESEND_API_KEY=
EMAIL_FROM="DesignArena <noreply@example.com>"

# Public site URL used in magic-link redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Development-only. Required to run `npm run seed:dev` against production
# (not recommended). Demo entries are labeled [SAMPLE].
# ALLOW_DEMO_SEED=true
